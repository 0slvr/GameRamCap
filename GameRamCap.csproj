<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameRamCap</AssemblyName>
    <RootNamespace>GameRamCap</RootNamespace>
    <Version>0.2.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Native.cs struct layouts (MEMORY_BASIC_INFORMATION, hook structs) are the 64-bit ones. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Memory: no background-GC thread and no PGO instrumentation (both only cost RAM in a small tray tool), and a GC that
         gives memory back sooner. See MemoryTrim.cs. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests have their own project: keep them out of the app. -->
    <Compile Remove="GameRamCap.Tests\**" />
    <EmbeddedResource Remove="GameRamCap.Tests\**" />
    <None Remove="GameRamCap.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a managed resource so the tray icon and every window can load it at run time (see AppIcon.cs). -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
